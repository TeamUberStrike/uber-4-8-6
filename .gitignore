# Unity 4.6 — local-only directories
/Library/
/Temp/
/Obj/
/Build/
/Builds/
/Logs/

# AssetRipper / bulk-port backups
/.bak_*/
/.monkey_island_rebind_brief.md

# Unity-generated solution/project files (regenerated on import)
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Standalone build output (do NOT commit binaries)
/windowsstandalone.exe
/windowsstandalone_Data/

# OS / IDE noise
.DS_Store
Thumbs.db
*.swp
*~

# Don't ignore .meta — Unity tracks asset import settings here
!*.meta

# MecanimRiskHarness one-shot arm token + crash breadcrumb (see MecanimRiskHarness.cs)
mecanim_risk.arm
mecanim_risk.lastrun.txt

# Machine-specific Claude Code MCP config (written by tools\setup-mcp.bat)
/.mcp.json

# UberClient v4.8.6 layout: code lives at the root; Assets/ only holds junctions to it (tools/setup-links.bat)
/Assets/Scripts/Assembly-CSharp
/Assets/Plugins/Assembly-CSharp-firstpass
/build/
!/Client.sln
!/Assembly-CSharp/Assembly-CSharp.csproj
!/Assembly-CSharp-firstpass/Assembly-CSharp-firstpass.csproj
/tools/EmbedResources.exe
/tools/Mono.Cecil.dll
